{
  "higpertext:hook_audit": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "higpertext-hook hook_audit --assistant antigravity --event PostToolUse",
            "timeout": 5
          }
        ],
        "matcher": ".*"
      }
    ]
  },
  "higpertext:hook_bash_guard": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "higpertext-hook hook_bash_guard --assistant antigravity --event PreToolUse",
            "timeout": 10
          }
        ],
        "matcher": "run_command"
      }
    ]
  },
  "higpertext:hook_read_guard": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "higpertext-hook hook_read_guard --assistant antigravity --event PreToolUse",
            "timeout": 5
          }
        ],
        "matcher": "view_file"
      }
    ]
  },
  "higpertext:hook_security_guard_post": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "higpertext-hook hook_security_guard_post --assistant antigravity --event PostToolUse",
            "timeout": 5
          }
        ],
        "matcher": ".*"
      }
    ]
  },
  "higpertext:hook_security_guard_pre": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "higpertext-hook hook_security_guard_pre --assistant antigravity --event PreToolUse",
            "timeout": 5
          }
        ],
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content"
      }
    ]
  }
}
